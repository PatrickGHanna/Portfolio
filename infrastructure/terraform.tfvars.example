# Copy this file to terraform.tfvars and update with your values

resource_group_name = "portfolio-rg"
location            = "East US"
project_name        = "portfolio"
environment         = "prod"
backend_sku         = "B1"

tags = {
  Environment = "Production"
  Project     = "Portfolio"
  ManagedBy   = "Terraform"
  Owner       = "YourName"
}

